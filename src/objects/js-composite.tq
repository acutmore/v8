#include 'src/objects/js-composite.h'

extern class JSComposite extends JSObject {
  hashcode: Smi;
}

transitioning javascript builtin CompositeIsComposite(
    js-implicit context: NativeContext,
    receiver: JSAny)(other: JSAny): Boolean {
  if (Is<JSComposite>(other)) {
    return True;
  } else {
    return False;
  }
}

extern transitioning runtime CompositeEqualHelper(
    NoContext, JSComposite, JSComposite): Boolean;

transitioning javascript builtin CompositeEqual(
    js-implicit context: NativeContext,
    receiver: JSAny)(a: JSAny, b: JSAny): Boolean {
  if (!Is<JSComposite>(a)) {
    return False;
  }
  if (!Is<JSComposite>(b)) {
    return False;
  }
  const ac = UnsafeCast<(JSComposite)>(a);
  const bc = UnsafeCast<(JSComposite)>(b);
  if (ac.hashcode != bc.hashcode) {
    return False;
  }
  if (ac.map != bc.map) {
    return False;
  }
  if (ac.elements.length != bc.elements.length) {
    return False;
  }
  return CompositeEqualHelper(kNoContext, ac, bc);
}

transitioning macro CompositeEqual(
    searchComposite: JSComposite, element: JSAny): Boolean {
  if (Is<JSComposite>(element)) {
    const elementComposite = UnsafeCast<JSComposite>(element);
    return CompositeEqualHelper(kNoContext, searchComposite, elementComposite);
  } else {
    return False;
  }
}
